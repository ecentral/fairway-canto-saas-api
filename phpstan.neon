parameters:
  level: 5
  paths:
    - src
  treatPhpDocTypesAsCertain: false
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - '#JetBrains\\PhpStorm\\ArrayShape#'
    - '#Attribute class .*ArrayShape.* does not exist#'
    - '#fetchAssociative\(\)#'
    -
      identifier: function.alreadyNarrowedType
    -
      identifier: function.notFound
      path: src/Http/UploadRequest.php
    -
      identifier: method.resultUnused
      path: src/Adapter/Driver.php
    -
      identifier: property.unusedType
    -
      identifier: return.unusedType
    -
    			message: "#^Call to function method_exists\\(\\) with 'GuzzleHttp\\\\\\\\Psr7\\\\\\\\Utils' and 'tryFopen' will always evaluate to false\\.$#"
    			count: 1
    			path: src/Http/UploadRequest.php
