{
  "name": "fairway/canto-saas-api",
  "type": "library",
  "description": "Client library for Canto SaaS APIs.",
  "homepage": "https://ecentral.de/fairway-dam-typo3",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "Canto",
    "API"
  ],
  "authors": [
    {
      "name": "eCentral GmbH",
      "role": "Project Owner",
      "email": "support@ecentral.de",
      "homepage": "https://www.ecentral.de"
    },
    {
      "name": "Tim Schreiner",
      "role": "Developer",
      "email": "tim.schreiner@km2.de"
    },
    {
      "name": "Christian Rodriguez Benthake",
      "role": "Developer",
      "email": "c.rodriguez.benthake@ecentral.de"
    },
    {
      "name": "Denis Doerner",
      "role": "Developer",
      "email": "d.doerner@ecentral.de",
      "homepage": "https://www.ecentral.de"
    },
    {
      "name": "Alex Hamann",
      "role": "Developer",
      "email": "a.hamann@ecentral.de",
      "homepage": "https://www.ecentral.de"
    },
    {
      "name": "Mohamad Omeirat",
      "role": "Developer",
      "email": "m.omeirat@ecentral.de",
      "homepage": "https://www.ecentral.de"
    }
  ],
  "require": {
    "php": "^8.0",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^6.3 || ^7.3",
    "psr/log": "^1.1 || ^3.0",
    "fairway/filesystem-api": "@dev"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.2",
    "rector/rector": "^2.5",
    "ssch/typo3-rector": "^3.15"
  },
  "autoload": {
    "psr-4": {
      "Fairway\\CantoSaasApi\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fairway\\CantoSaasApi\\Tests\\": "tests"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --using-cache=no --config=.php-cs-fixer.dist.php",
    "cs:fix": "php-cs-fixer fix --diff --using-cache=no --config=.php-cs-fixer.dist.php",
    "analyze:php": "phpstan analyse --ansi --no-progress --memory-limit=768M -c phpstan.neon",
    "rector:check": "rector process --dry-run --no-progress-bar --memory-limit=768M",
    "rector:fix": "rector process --no-progress-bar --memory-limit=768M"
  }
}
